# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
# Optional Azure / proxy base URL. LEAVE THIS LINE COMMENTED OUT for openai.com — an
# empty value here will break the OpenAI SDK with an UnsupportedProtocol error.
# OPENAI_BASE_URL=https://your-azure-endpoint.openai.azure.com/
# Primary mini model for all LLM calls (vision, edit-intent, generate_plan, judges)
OPENAI_MODEL=gpt-4.1-mini
# Secondary mini model used only by the A/B evals experiment
OPENAI_MODEL_B=gpt-4o-mini
# Embeddings: 1536-dim
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=trip-planner
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=trip_planner_v1

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SESSION_STORE_PATH=./sessions
CHECKPOINT_DB_PATH=./checkpoints/graph.sqlite

# --- Eval mode ---
EVAL_MODE=false

# --- Frontend ---
VITE_BACKEND_URL=http://localhost:8000
